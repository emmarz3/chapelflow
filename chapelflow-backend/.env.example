SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Lagos

DATABASE_URL=postgres://chapelflow:chapelflow@localhost:5432/chapelflow

REDIS_URL=redis://localhost:6379/0

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

STORAGE_PROVIDER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Supabase (service_role key only — server-side, bypasses RLS)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=chapelflow-uploads

MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp,pdf,mp3,mp4,docx

PAYSTACK_SECRET_KEY=
# The ChapelFlow URL Paystack should return a giver to after checkout.
PAYSTACK_CALLBACK_URL=https://chapelflow.example.edu.ng/app/giving
FLUTTERWAVE_SECRET_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@chapelflow.app

SMS_API_KEY=
SMS_PROVIDER=termii
SMS_SENDER_ID=N-Alert

PUSH_NOTIFICATION_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

MATRIC_NUMBER_REGEX=^[A-Z]{2,6}/[0-9]{2,4}/[0-9]{3,6}$
QR_TOKEN_TTL_HOURS=720
ATTENDANCE_DUPLICATE_WINDOW_MIN=120
MFA_ENFORCED_ROLES=SUPER_ADMIN,CHAPEL_ADMIN,FINANCE_OFFICER
MFA_ENFORCE_ROLE_OBJECTS=True

# Used only by `python manage.py bootstrap_super_admin`; never commit real values.
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=replace-with-a-long-unique-password
SUPER_ADMIN_FIRST_NAME=ChapelFlow
SUPER_ADMIN_LAST_NAME=Administrator

FRONTEND_URL=http://localhost:3000
