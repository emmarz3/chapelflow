
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR-AWS-API-DOMAIN/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://YOUR-AWS-API-DOMAIN/admin/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://YOUR-AWS-API-DOMAIN/static/$1"
    },
    {
      "source": "/health/",
      "destination": "https://YOUR-AWS-API-DOMAIN/health/"
    },
    {
      "source": "/liveness/",
      "destination": "https://YOUR-AWS-API-DOMAIN/liveness/"
    },
    {
      "source": "/readiness/",
      "destination": "https://YOUR-AWS-API-DOMAIN/readiness/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
