{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "chapelflow-api": {
      "root": ".",
      "framework": "vite"
    },
    "chapelflow-backend": {
      "root": "chapelflow-backend",
      "framework": "django"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "chapelflow-api"
      }
    }
  ]
}
